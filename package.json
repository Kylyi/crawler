{
  "name": "crawler",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "ready": "tsx scripts/main.ts -- lint && tsx scripts/main.ts -- typecheck && vp run -r test && tsx scripts/main.ts -- build",
    "scripts": "tsx scripts/main.ts"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@crawler/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "picocolors": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  }
}
