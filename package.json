{
  "name": "crawler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run fe-vue#dev",
    "dev:nuxt4": "vp run fe-nuxt4#dev",
    "dev:nuxt5": "vp run fe-nuxt5#dev",
    "lint": "vp run -r lint",
    "prepare": "vp config"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@crawler/eslint-config": "workspace:*",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.18.0"
}
