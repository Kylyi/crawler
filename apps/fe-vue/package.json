{
  "name": "fe-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p --node-run type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "build-only": "vp build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module vp build",
    "deploy:cloudflare": "wrangler deploy --config .output/server/wrangler.json",
    "db:apply:local": "wrangler d1 migrations apply fe-vue-db --local",
    "db:apply:remote": "wrangler d1 migrations apply fe-vue-db --remote",
    "db:migrations:list": "wrangler d1 migrations list fe-vue-db --local",
    "crawl:zakazky-gov": "curl -s -X POST http://localhost:3000/api/crawl/zakazky-gov",
    "crawl:zakazky-gov:detail": "curl -s -X POST 'http://localhost:3000/api/crawl/zakazky-gov/detail?limit=50'",
    "crawl:zakazky-gov:detail:all": "bash scripts/ingest-detail-all.sh",
    "crawl:zakazky-gov:catch-up": "curl -s -X POST 'http://localhost:3000/api/crawl/zakazky-gov/catch-up?limit=50'",
    "type-check": "vue-tsc --build",
    "lint": "run-s --node-run \"lint:*\"",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt src/"
  },
  "dependencies": {
    "@pinia/colada": "catalog:",
    "@vueuse/core": "catalog:",
    "nitro": "catalog:",
    "ofetch": "catalog:",
    "pinia": "^4.0.2",
    "vue": "3.6.0-rc.1",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.61.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-playwright": "^2.10.5",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.115.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
